{
  "name": "auction-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-datasource.mjs && prisma generate && node scripts/provision-db.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "node scripts/prepare-datasource.mjs && prisma db push",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed/index.ts",
    "db:reset": "prisma db push --force-reset --skip-generate && npm run db:seed",
    "db:studio": "prisma studio",
    "verify:reset-token": "node --env-file=.env --import tsx scripts/verify-reset-token.ts",
    "verify:seal": "node --env-file=.env --import tsx scripts/verify-seal.ts",
    "verify:totp-replay": "node --env-file-if-exists=.env --import tsx scripts/verify-totp-replay.ts",
    "e2e": "node scripts/e2e.mjs",
    "db:use-postgres": "node scripts/switch-datasource.mjs postgresql",
    "db:use-sqlite": "node scripts/switch-datasource.mjs sqlite",
    "db:deploy": "node scripts/prepare-datasource.mjs && prisma db push --accept-data-loss && npm run db:seed",
    "flow": "node scripts/flow.mjs",
    "audit": "node scripts/audit.mjs",
    "rules": "node scripts/rules.mjs",
    "manual": "node scripts/build-manual.mjs",
    "verify:all": "npm run db:seed && npm run e2e && npm run audit && npm run flow && npm run rules && npm run concurrency && npm run verify:reset-token && npm run verify:seal && npm run verify:totp-replay",
    "concurrency": "node scripts/concurrency.mjs",
    "demo:reset": "node scripts/reset-demo.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.11",
    "next": "15.5.25",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "jszip": "^3.10.1",
    "playwright": "^1.62.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "msgpackr-extract@3.0.4": true,
    "workerd@1.20260704.1": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "playwright@1.62.1": true
  }
}
