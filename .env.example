# --- database -------------------------------------------------------------
# Demo (SQLite, no server required)
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) - run `npm run db:use-postgres` first
# DATABASE_URL="postgresql://user:password@host:5432/sktes?sslmode=require"

# --- secrets --------------------------------------------------------------
# Signs session tickets. Any long random string.
SESSION_SECRET="change-me-to-a-long-random-string"

# Wraps every per-lot sealed-bid private key. MUST be 64 hex characters
# (32 bytes) and MUST be stored outside the database - in Azure Key Vault or
# the platform secret store, never in the repository.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEAL_MASTER_KEY="6b1f0c4e9a7d2358e14c8b06f39a5d72c0e8471bd9265a3f8c17e04b2d95a6f3"

# --- environment ----------------------------------------------------------
# Enables demo-only features (the data reset button). Never "true" in production.
DEMO_MODE="true"

# Used for sitemap.xml and robots.txt absolute URLs.
SITE_URL="http://localhost:3000"
